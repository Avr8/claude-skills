diff --git a/client/http.py b/client/http.py
--- a/client/http.py
+++ b/client/http.py
@@ -1,12 +1,24 @@
 import requests
+import logging
+
+log = logging.getLogger(__name__)
+MAX_RETRIES = 5
 
-def fetch_invoice(session, invoice_id):
-    resp = session.get(f"{BASE}/invoices/{invoice_id}", timeout=10)
-    resp.raise_for_status()
-    return resp.json()
+def fetch_invoice(session, invoice_id, retries=MAX_RETRIES):
+    for attempt in range(retries):
+        try:
+            resp = session.get(f"{BASE}/invoices/{invoice_id}", timeout=10)
+            resp.raise_for_status()
+            return resp.json()
+        except Exception as e:
+            log.debug("fetch failed attempt %s: %s", attempt, e)
+            continue
+    return None
